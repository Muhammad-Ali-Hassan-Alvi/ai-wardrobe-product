# =============================================================================

# AI Wardrobe — Environment Variables

# Copy to .env.local and fill in values. Never commit .env.local

# =============================================================================



# -----------------------------------------------------------------------------

# App Configuration

# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000



# Skip @t3-oss/env-nextjs validation (build/CI only)

SKIP_ENV_VALIDATION=



# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Find strings: Project home → "Connect" button → URI (NOT Project Settings → General)
# DIRECT_URL = Direct connection, port 5432 (migrations)
# DATABASE_URL = Transaction pooler, port 6543 (app runtime)
# -----------------------------------------------------------------------------
# Pooled — app runtime. Copy exact host from Supabase Connect (e.g. aws-1-ap-southeast-1)
DATABASE_URL=postgresql://postgres.[project-ref]:[password-url-encoded]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations — session pooler (5432) recommended; db.* host may be IPv6-only
DIRECT_URL=postgresql://postgres.[project-ref]:[password-url-encoded]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres



# -----------------------------------------------------------------------------

# Authentication — Supabase Auth

# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy fallback:

# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key



# -----------------------------------------------------------------------------

# AI Providers

# -----------------------------------------------------------------------------

# gemini | openai | anthropic

AI_PROVIDER=gemini

# Default model (gemini-2.0-flash free tier was retired — use 2.5+)
GEMINI_MODEL=gemini-2.5-flash

GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# OPENAI_API_KEY=

# ANTHROPIC_API_KEY=



# -----------------------------------------------------------------------------

# Virtual Try-On Providers

# -----------------------------------------------------------------------------

# fal | replicate | stub

# --- Styling analysis + chat (text/vision models from your AI Studio dashboard) ---
GEMINI_MODEL=gemini-2.5-flash

# --- Virtual try-on ---
# auto = Fal (if key) → Gemini image → Cloudinary overlay (always shows clothes on you)
# gemini | composite | fal | replicate | stub
TRYON_PROVIDER=auto

# When Gemini image step runs (NOT the same as GEMINI_MODEL)
GEMINI_TRYON_MODEL=gemini-2.5-flash-image

# Fal FASHN — recommended for photorealistic try-on (https://fal.ai)
FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6
# FAL_API_KEY=

# Optional: Cloudinary overlay fallback when TRYON_PROVIDER=gemini|fal (default off)
ALLOW_TRYON_COMPOSITE_FALLBACK=false

# REPLICATE_API_TOKEN=

# TRYON_WEBHOOK_SECRET=



# -----------------------------------------------------------------------------

# Storage Providers

# -----------------------------------------------------------------------------

# cloudinary | s3

STORAGE_PROVIDER=cloudinary



NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

CLOUDINARY_CLOUD_NAME=your-cloud-name

CLOUDINARY_API_KEY=your-api-key

CLOUDINARY_API_SECRET=your-api-secret



# AWS_S3_BUCKET=

# AWS_S3_REGION=

# AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY=



# -----------------------------------------------------------------------------

# Payments (future)

# -----------------------------------------------------------------------------

# STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET=

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=



# -----------------------------------------------------------------------------

# Observability & Rate Limiting (optional)

# -----------------------------------------------------------------------------

# UPSTASH_REDIS_REST_URL=

# UPSTASH_REDIS_REST_TOKEN=

# SENTRY_DSN=

# SENTRY_AUTH_TOKEN=

